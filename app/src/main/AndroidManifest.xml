<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SparkletApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
        singleTask + the two intent-filters below is load-bearing, not
        boilerplate: the mobile-auth redirect (sparklet-android://auth?code=)
        must land back on this same Activity instance via onNewIntent, not
        spawn a fresh one that's lost whatever sign-in state was in flight.
        See auth/LoginController.kt and auth/AuthRedirect.kt.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
            Backend's /api/auth/mobile-complete redirects here once sign-in
            completes: sparklet-android://auth?code=<code>. The scheme must
            exactly match an entry in ALLOWED_MOBILE_SCHEMES
            (sparklet/src/lib/mobile-auth.ts) — verified there as of
            2026-07-28 — and the host must be "auth" to match that redirect.
            A raw custom scheme has no ownership verification on Android
            (unlike a verified App Link with assetlinks.json); see
            AGENTS.md's auth section for why that upgrade isn't done yet.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="sparklet-android"
                    android:host="auth" />
            </intent-filter>
        </activity>
    </application>
</manifest>
